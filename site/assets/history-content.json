          "objective": "规划传单路线，依次抵达三个接应点。",
          "cardKeys": [
            "march"
          ],
          "mechanic": {
            "type": "route"
          },
          "viewId": "y1919:1",
          "artLayout": "y1919:1",
          "dialogueLabel": "情境创作，非史料原文",
          "estimatedMinutes": 1
        },
        {
